{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "THOS City Mesh Telemetry Packet",
  "type": "object",
  "required": ["packet_id", "source_node", "timestamp", "thos_profile", "d2l_state", "payload"],
  "properties": {
    "packet_id": {"type": "string"},
    "source_node": {"type": "string"},
    "timestamp": {"type": "string"},
    "thos_profile": {
      "type": "string",
      "enum": ["THOS-GEO", "THOS-ROUTE", "THOS-BIO", "THOS-ENV", "THOS-ATMOS", "THOS-AAS", "THOS-GOV", "THOS-SEC", "THOS-MESH", "THOS-CAD", "THOS-MAP"]
    },
    "d2l_state": {"type": "string", "enum": ["Dark", "Grey", "Light", "Bright"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "jurisdiction": {"type": "string"},
    "risk_class": {"type": "string", "enum": ["C0", "C1", "C2", "C3", "C4"]},
    "payload": {"type": "object"},
    "provenance": {"type": "object"}
  }
}
